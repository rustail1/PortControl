            "target": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "target"
          ],
          "properties": {
            "type": {
              "const": "survive_seconds"
            },
            "target": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            }
          }
        }
      ]
    },
    "star": {
