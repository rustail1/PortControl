{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "level.schema.json",
  "title": "Port Control LevelConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "order",
    "portId",
    "objective",
    "starConditions",
    "allowedShips",
    "cargoTypes",
    "director",
    "cargoGeneration",
    "layout",
    "rewards",
    "seedMode",
    "flags"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "order": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999
    },
    "portId": {
      "type": "string"
    },
    "focus": {
      "type": "string"
    },
    "objective": {
      "$ref": "#/$defs/objective"
    },
    "starConditions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/star"
      }
    },
    "allowedShips": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "shipWeights": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "cargoTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "general",
          "container",
          "oil"
        ]
      }
    },
    "cargoGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "weights",
        "multiCargoChance"
      ],
      "properties": {
        "mode": {
          "enum": [
            "single",
            "mixed"
          ]
        },
        "weights": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "multiCargoChance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "director": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startInterval",
        "minimumInterval",
        "warningLeadTime",
        "maxAlive",
        "pressureCap",
        "jitter",
        "wave"
      ],
      "properties": {
        "startInterval": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimumInterval": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "warningLeadTime": {
          "type": "number",
          "minimum": 0
        },
        "maxAlive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "pressureCap": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "jitter": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "wave": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "burstMin",
            "burstMax",
            "breathMin",
            "breathMax"
          ],
          "properties": {
            "burstMin": {
              "type": "integer",
              "minimum": 1
            },
            "burstMax": {
              "type": "integer",
              "minimum": 1
            },
            "breathMin": {
              "type": "number",
              "minimum": 0
            },
            "breathMax": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "templateId",
        "blocks"
      ],
      "properties": {
        "templateId": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "rewards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseCoins"
      ],
      "properties": {
        "baseCoins": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "seedMode": {
      "enum": [
        "random",
        "fixed",
        "daily"
      ]
    },
    "seed": {
      "type": "integer"
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supportsUpgradeDock",
        "allowRewind"
      ],
      "properties": {
        "supportsUpgradeDock": {
          "type": "boolean"
        },
        "allowRewind": {
          "type": "boolean"
        },
        "tutorialStep": {
          "type": [
            "string",
            "null"
          ]
        },
        "scriptedIntroShip": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "objective": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "target"
          ],
          "properties": {
            "type": {
              "const": "deliver_cargo"
            },
            "target": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "target",
            "cargoType"
          ],
          "properties": {
            "type": {
              "const": "deliver_cargo_type"
            },
            "target": {
              "type": "integer",
              "minimum": 1
            },
            "cargoType": {
              "enum": [
                "general",
                "container",
                "oil"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "target"
          ],
          "properties": {
            "type": {
              "const": "service_ships"
