{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "modifiers"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "modifiers": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "const": "spawn_interval_multiplier"
              },
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "const": "incoming_warning_bonus"
              },
              "value": {
                "type": "number",
                "minimum": -5,
                "maximum": 5
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "const": "objective_target_multiplier"
              },
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "const": "rewind_enabled"
              },
              "value": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "const": "unload_speed_multiplier"
              },
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "const": "bonus_break_on_warning"
              },
              "value": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "value",
              "shipId"
            ],
            "properties": {
              "type": {
                "const": "ship_spawn_weight_multiplier"
              },
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "shipId": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "hazardType"
            ],
            "properties": {
              "type": {
                "const": "enable_hazard"
              },
              "hazardType": {
                "enum": [
                  "storm",
                  "current",
                  "fog"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "cargoTypes",
              "pressureMultiplier"
            ],
            "properties": {
              "type": {
                "const": "cargo_filter"
              },
              "cargoTypes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "general",
                    "container",
                    "oil"
                  ]
                }
              },
              "pressureMultiplier": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        ]
      }
    }
  }
}
