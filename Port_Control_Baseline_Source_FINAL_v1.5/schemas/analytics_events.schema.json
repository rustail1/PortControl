{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analytics_events.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "privacy",
    "parameters",
    "events"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noPII",
        "noRawPointerSamples"
      ],
      "properties": {
        "noPII": {
          "const": true
        },
        "noRawPointerSamples": {
          "const": true
        }
      }
    },
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "string",
              "integer",
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    "events": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "optional"
        ],
        "properties": {
          "required": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "optional": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
