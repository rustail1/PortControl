{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "normalization",
    "levels"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "normalization": {
      "type": "object"
    },
    "levels": {
      "type": "object",
      "minProperties": 40,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
