{
  "name": "port-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:configs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "validate:configs": "tsx scripts/validate-configs.ts",
    "test": "npm run validate:configs && node --import tsx --test \"test/*.test.mjs\"",
    "test:browser": "node test/browser/cor12-smoke.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
